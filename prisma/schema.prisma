// Prisma schema for Nodebase Enterprise Edition
// SaaS features (payments/subscriptions) have been removed

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// Authentication Models (Better Auth)
// ============================================

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  workflows     Workflow[]
  credentials   Credential[]
  projects      Project[]
  templates     Template[]
  packages      Package[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

// ============================================
// Credential Management
// ============================================

enum CredentialType {
  OPENAI
  ANTHROPIC
  GEMINI
}

model Credential {
  id        String         @id @default(cuid())
  name      String
  value     String
  type      CredentialType
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes     Node[]
}

// ============================================
// Workflow Models
// ============================================

model Workflow {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  nodes       Node[]
  connections Connection[]
  executions  Execution[]
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Project connection
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Template origin (if created from template)
  templateId  String?

  // iOS Testing Fields
  targetAppPath  String? // Path to .app file
  bundleId       String? // App Bundle ID (e.g., com.example.app)
  targetDeviceId String? // Simulator UDID
  platform       String? @default("ios") // "ios" | "android" (future)

  uiComponents     UIComponent[]
  goldenMasters    GoldenMaster[]
  packageWorkflows PackageWorkflow[]

  @@index([projectId])
}

enum NodeType {
  // 既存のノードタイプ
  INITIAL
  MANUAL_TRIGGER
  SCHEDULE_TRIGGER    // 定期実行（Cron）
  INTERVAL_TRIGGER    // タイマー実行（一定間隔）
  HTTP_REQUEST
  ANTHROPIC
  GEMINI
  OPENAI
  DISCORD
  SLACK

  // === iOSテスト: シミュレータ制御 ===
  IOS_SIMULATOR_BOOT
  IOS_SIMULATOR_SHUTDOWN
  IOS_APP_INSTALL
  IOS_APP_UNINSTALL
  IOS_APP_LAUNCH
  IOS_APP_TERMINATE

  // === iOSテスト: 実機制御 ===
  IOS_DEVICE_APP_INSTALL
  IOS_DEVICE_APP_UNINSTALL
  IOS_DEVICE_APP_LAUNCH
  IOS_DEVICE_APP_TERMINATE

  // === iOSテスト: セットアップ ===
  IOS_WDA_SETUP

  // === iOSテスト: UIインタラクション ===
  IOS_TAP
  IOS_TEXT_INPUT
  IOS_SWIPE
  IOS_SCROLL_UNTIL_VISIBLE
  IOS_PICKER_SELECT
  IOS_SLIDER_SET
  IOS_TOGGLE_SWITCH
  IOS_SCREENSHOT
  IOS_VIDEO_RECORDING
  IOS_WAIT

  // === iOSテスト: 検証（Expect） ===
  IOS_EXPECT_EXISTS
  IOS_EXPECT_TEXT
  IOS_EXPECT_VALUE
  IOS_EXPECT_VISUAL

  // === iOSテスト: 解析 ===
  IOS_UI_SCAN
}

model Node {
  id                String       @id @default(cuid())
  workflowId        String
  workflow          Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name              String
  type              NodeType
  position          Json
  data              Json         @default("{}")
  credentialId      String?
  credential        Credential?  @relation(fields: [credentialId], references: [id])
  outputConnections Connection[] @relation("FromNode")
  inputConnections  Connection[] @relation("ToNode")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Connection {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromNodeId String
  fromNode   Node     @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId   String
  toNode     Node     @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)
  fromOutput String   @default("main")
  toInput    String   @default("main")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fromNodeId, toNodeId, fromOutput, toInput])
}

// ============================================
// Execution History
// ============================================

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
}

model Execution {
  id             String          @id @default(cuid())
  workflowId     String
  workflow       Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status         ExecutionStatus @default(RUNNING)
  error          String?         @db.Text
  errorStack     String?         @db.Text
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  inngestEventId String          @unique
  output         Json?

  // iOS Testing Artifacts
  artifacts Json?   // Array of screenshot URLs
  videoUrl  String? // Recording URL (optional)
}

// ============================================
// iOS Testing: UI Component Analysis
// ============================================

model UIComponent {
  id              String   @id @default(cuid())
  workflowId      String?
  workflow        Workflow? @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accessibilityId String
  componentType   String // "Button", "TextField", "Toggle", etc.
  label           String?
  sourceFilePath  String?  // 画面名として使用
  sourceLineNumber Int?
  positionX       Float?
  positionY       Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([projectId, accessibilityId])
  @@index([workflowId])
  @@index([projectId])
  @@index([sourceFilePath])
}

// ============================================
// iOS Testing: Screen Name Management
// ============================================

model ProjectScreen {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filePath    String   // 元のファイルパス or スキャン時の識別子
  screenName  String   // ユーザーが設定する画面名
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([projectId, filePath])
  @@index([projectId])
}

// ============================================
// iOS Testing: Visual Regression
// ============================================

model GoldenMaster {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodeId     String
  name       String
  imageUrl   String
  createdAt  DateTime @default(now())
}

// ============================================
// Project Management
// ============================================

model Project {
  id             String   @id @default(cuid())
  name           String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Xcode Project Information
  projectPath    String   // Local path to .xcodeproj/.xcworkspace
  bundleId       String?  // Auto-detected Bundle ID
  targetDeviceId String?  // Default simulator UDID
  appPath        String?  // Path to built .app file

  // Apple Developer Signing (for physical device testing)
  xcodeOrgId     String?  // Apple Developer Team ID
  xcodeSigningId String?  // Signing identity (default: "iPhone Developer")

  // Metadata
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  workflows      Workflow[]
  templates      Template[]
  uiComponents   UIComponent[]
  packages       Package[]
  screens        ProjectScreen[]

  @@index([userId])
}

// ============================================
// Workflow Templates
// ============================================

model Template {
  id                     String   @id @default(cuid())
  name                   String
  description            String?
  projectId              String?  // null = system default template
  project                Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId                 String?  // For custom templates
  user                   User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Template content
  definition             Json     // React Flow format (nodes + edges)
  category               String   // "default" | "custom"
  tags                   String[] // Search tags

  // Settings
  includesSimulatorConfig Boolean @default(true)
  defaultVariables       Json?    // Default values for template variables

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([category])
}

// ============================================
// Package Management (Workflow Groups)
// ============================================

enum ExecutionMode {
  PARALLEL
  SEQUENTIAL
}

model Package {
  id            String        @id @default(cuid())
  name          String
  description   String?
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  executionMode ExecutionMode @default(SEQUENTIAL)

  workflows  PackageWorkflow[]
  executions PackageExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
}

model PackageWorkflow {
  id         String   @id @default(cuid())
  packageId  String
  package    Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  order      Int      @default(0)

  @@unique([packageId, workflowId])
  @@index([packageId])
}

model PackageExecution {
  id          String          @id @default(cuid())
  packageId   String
  package     Package         @relation(fields: [packageId], references: [id], onDelete: Cascade)
  status      ExecutionStatus @default(RUNNING)
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  error       String?         @db.Text

  // Results for each workflow execution
  results Json?

  @@index([packageId])
}
